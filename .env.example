# Environment Configuration
# Copy this file to .env and fill in your actual values

# ========================
# NODE & APP CONFIGURATION
# ========================
NODE_ENV=development
PORT=5000
APP_NAME=Gig_Economy_Backend
APP_VERSION=1.0.0

# ========================
# DATABASE CONFIGURATION
# ========================
# Choose one: mongodb or postgresql
DATABASE_TYPE=mongodb

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/gig_economy
MONGO_USER=admin
MONGO_PASSWORD=your_password_here
MONGO_POOL_SIZE=10
MONGO_TIMEOUT=10000

# PostgreSQL Configuration (if using PostgreSQL)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=gig_economy
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password_here
# POSTGRES_POOL_SIZE=10

# ========================
# JWT & AUTHENTICATION
# ========================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# ========================
# EXTERNAL SERVICES
# ========================

# Squad Payment API (GTBank)
SQUAD_API_BASE_URL=https://api.sandbox.squad.co
SQUAD_API_KEY=your_squad_api_key_here
SQUAD_WEBHOOK_SECRET=your_squad_webhook_secret_here

# Gemini AI (Google - Free Tier)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# File Upload Configuration
MAX_FILE_SIZE=5242880
MAX_FILES_PER_UPLOAD=10

# Email Service (SendGrid or Nodemailer)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
# OR Nodemailer SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=noreply@gigeconomy.com

# SMS Service (Twilio - optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Processing (Stripe)
STRIPE_PUBLIC_KEY=pk_test_your_public_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ========================
# AWS / STORAGE (optional)
# ========================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=gig-economy-uploads
AWS_S3_URL=https://your-bucket.s3.amazonaws.com

# ========================
# LOGGING & MONITORING
# ========================
LOG_LEVEL=debug
LOG_FORMAT=json
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ========================
# CORS & SECURITY
# ========================
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================
# API KEYS
# ========================
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret

# ========================
# FEATURE FLAGS
# ========================
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PAYMENT_PROCESSING=true
ENABLE_SOCIAL_LOGIN=false

# ========================
# TESTING
# ========================
TEST_DATABASE_URL=mongodb://localhost:27017/gig_economy_test
TEST_JWT_SECRET=test_jwt_secret_for_testing_only
