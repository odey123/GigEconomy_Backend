{
  "info": {
    "_postman_id": "gig-economy-api-collection",
    "name": "Gig Economy API - Layers 1 & 2",
    "description": "Complete API collection for Auth + Squad Wallet (Layer 1) and Gigs (Layer 2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Layer 1: Auth + Wallet",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "1. Signup (Owner)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    var jsonData = pm.response.json();",
                      "    pm.environment.set('token', jsonData.data.token);",
                      "    pm.environment.set('userId', jsonData.data.user._id);",
                      "    pm.environment.set('userRole', jsonData.data.user.role);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firstName\": \"Rock\",\n  \"lastName\": \"Healthy\",\n  \"email\": \"rockhealthy@example.com\",\n  \"phone\": \"+2348012345678\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"client\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/signup",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "signup"
                  ]
                }
              }
            },
            {
              "name": "2. Signup (Helper)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    var jsonData = pm.response.json();",
                      "    pm.environment.set('helperToken', jsonData.data.token);",
                      "    pm.environment.set('helperId', jsonData.data.user._id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Helper\",\n  \"email\": \"john.helper@example.com\",\n  \"phone\": \"+2348087654321\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"worker\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/signup",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
